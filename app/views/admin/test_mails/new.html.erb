<% content_for :title, t("test_mailer.page_title") %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<div class="mx-auto" style="max-width: 36rem;">
  <h1 class="h3 mb-3"><%= t("test_mailer.page_title") %></h1>
  <p class="text-body-secondary"><%= t("test_mailer.intro") %></p>

  <% if @error %>
    <div class="alert alert-danger" role="alert"><%= @error %></div>
  <% end %>

  <%= form_with url: admin_test_mail_path, method: :post do |f| %>
    <div class="mb-3">
      <%= f.label :to, t("test_mailer.recipient"), class: "form-label" %>
      <%= f.email_field :to, value: @to, required: true, class: "form-control" %>
    </div>
    <%= f.button type: "submit", class: "btn btn-primary" do %>
      <i class="fa-solid fa-paper-plane me-2" aria-hidden="true"></i><%= t("test_mailer.send") %>
    <% end %>
  <% end %>

  <h2 class="h5 mt-5 mb-3"><%= t("test_mailer.previews_title") %></h2>
  <div class="d-flex justify-content-between align-items-center mb-2">
    <strong><%= t("test_mailer.friend_invitation_preview") %></strong>
    <%= link_to t("test_mailer.open_preview"), admin_friend_invitation_preview_path, target: "_blank", rel: "noopener", class: "small" %>
  </div>
  <iframe src="<%= admin_friend_invitation_preview_path %>" title="<%= t("test_mailer.friend_invitation_preview") %>"
          class="w-100 border rounded bg-white" style="height: 24rem;"></iframe>
</div>
