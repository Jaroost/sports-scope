<h1 style="font-size: 20px;"><%= t("friend_mailer.invitation.title", name: @inviter_name) %></h1>
<p><%= t("friend_mailer.invitation.body", name: @inviter_name) %></p>
<p>
  <a href="<%= @invite_url %>" style="display: inline-block; padding: 10px 18px; background: #0d6efd; color: #fff; text-decoration: none; border-radius: 6px;">
    <%= t("friend_mailer.invitation.cta") %>
  </a>
</p>
<p style="color: #666; font-size: 13px;"><%= t("friend_mailer.invitation.privacy") %></p>
<p style="color: #666; font-size: 13px;"><%= t("friend_mailer.invitation.ignore") %></p>
